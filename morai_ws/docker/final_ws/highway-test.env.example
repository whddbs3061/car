# Saved test settings. Copy to highway-test.env; edit that local copy.
# Prefer: bash run_test.sh drive NUMBER (does not modify TEST_PROFILE).
# 1 curvature / 2 curvature_signal / 3 obstacle_signal / 4 merge_signal / 5 full
# obstacle_signal: curvature + general signal stops + automatic obstacle detours
# merge_signal: curvature + general signal stops + requested merge; blocked route stops
# Cases 3-5 use the highway stopline controller, not case 2's directional route signals.
# full: lanes + obstacles + requested merge + YOLO/stopline
# obstacle: lanes + obstacles, no highway request or YOLO/stopline control
# merge: lanes + obstacles + requested merge, no YOLO/stopline control
# curvature: original route only; no camera/LiDAR collision or signal stops
# curvature_signal: original route + curvature + route-associated stopline/signals only
TEST_PROFILE=full
OPEN_CAMERA_DASHBOARD=true

# Shared curve/longitudinal settings; speeds are km/h unless named mps2.
MAX_SPEED_KPH=5.0
LATERAL_ACCEL_LIMIT_MPS2=1.0
MAX_ACCEL_MPS2=1.0
MAX_DECEL_MPS2=1.5
CURVE_PLANNING_DECEL_MPS2=0.8
SPEED_KP=0.8
SPEED_KI=0.05
PEDAL_ACCEL_RISE_RATE_PER_SEC=0.7
PEDAL_BRAKE_RISE_RATE_PER_SEC=1.5
PEDAL_RELEASE_RATE_PER_SEC=2.0
SPEED_INTEGRAL_LIMIT_KPH_S=10.8
SPEED_ERROR_DEADBAND_KPH=0.1
LOOKAHEAD_MIN_M=4.0
LOOKAHEAD_GAIN=0.35
LOOKAHEAD_MAX_M=12.0
LOOKAHEAD_TIGHT_MIN_M=2.2
LOOKAHEAD_CURVATURE_GAIN=6.0
STEERING_FEEDFORWARD_WEIGHT=0.35
MAX_STEERING_RATE_RAD_S=0.5
# Case 2 only: CAM1 residual correction relative to the MGeo route.
# `bash run_test.sh lane on` applies this bounded, filtered assist preset.
# Camera observations must remain fresh and stable before correction ramps in.
LANE_CENTERING_ENABLED=true
LANE_CENTERING_WEIGHT=0.45
LANE_CENTERING_MAX_CORRECTION_RAD=0.065
LANE_CENTERING_MIN_CONFIDENCE=0.65
LANE_CENTERING_TIMEOUT_SEC=0.4
LANE_CENTERING_MIN_FRAMES=4
LANE_CENTERING_FILTER_TAU_SEC=0.25
LANE_CENTERING_CORRECTION_RATE_RAD_S=0.10
LANE_CENTERING_RELEASE_RATE_RAD_S=0.10
# Case 2 only: escape4 highway section (lane changes to L3, 28 km/h at the
# highway end); false runs case 2 without it.
HIGHWAY_ENABLED=true
AVOIDANCE_ENABLED=true

# Case 2: mapped RED/UNKNOWN approach cap. A confirmed route GREEN releases it.
STOPLINE_APPROACH_SPEED_KPH=30.0
STOPLINE_CAP_RELEASE_AFTER_M=5.0
STOPLINE_CAP_MAX_DETECTION_RANGE_M=60.0
STOPLINE_CAP_MIN_CONFIDENCE=0.55

# Sensor ports on Ubuntu / control receiving port on Windows.
GPS_PORT=3001
IMU_PORT=4001
COMPETITION_STATUS_PORT=9099
COMPETITION_STATUS_SOURCE_PORT=9088
CONTROL_REMOTE_PORT=9093
CONTROL_SOURCE_PORT=9094
LANE_INFO_PORT=1101
YOLO_PORT=1131
ROI_LIDAR_HOST_PORT=2000
ROI_LIDAR_PORT=2001

# Camera settings also apply to curvature_signal. cuda requires a working GPU.
LANE_INFO_DEVICE=cuda
LANE_INFO_EVERY=1
LANE_MIN_CONFIDENCE=0.45
LANE_INFO_TIMEOUT_S=0.6
FRONT_MIN_GAP_M=6.0
REAR_MIN_GAP_M=7.0
TIME_HEADWAY_S=1.5
MIN_TTC_S=3.0
MAX_LANE_CHANGES=1
EVALUATION_SPEED_MPS=2.0
STOPLINE_FRONT_REFERENCE_OFFSET_M=3.845

# curvature_signal only. Path is INSIDE the Docker container.
SIGNAL_CONFIG_FILE=/opt/AutoVehicle/morai_ws/config/curvature_signal.yaml
# Progressive stopping: distance-based speed curve, front bumper stops 0.5 m away.
# Detection/ramp distance alone does not request the brake pedal.
STOPLINE_HOLD_DISTANCE_M=0.5
STOPLINE_PLANNING_DECEL_MPS2=1.2
STOPLINE_BRAKE_RAMP_DISTANCE_M=0.0
STOPLINE_SETTLE_DISTANCE_M=0.15
SIGNAL_RIGHT_ON_GREEN=true

# Use the actual MORAI LiDAR mounting translation/yaw relative to base_link.
LIDAR_X_M=0.0
LIDAR_Y_M=0.0
LIDAR_Z_M=0.0
LIDAR_YAW_DEG=0.0
