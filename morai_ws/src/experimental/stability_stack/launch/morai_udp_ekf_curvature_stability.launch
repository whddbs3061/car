<launch>
  <!--
    원본 GPS/IMU + ENU EKF + 곡률 기반 Pure Pursuit 독립 실행 파일.
    센서 입력에는 인위적인 noise나 별도 noise filter를 적용하지 않는다.
    GPS blackout은 GpsHealth로 감시하고, blackout 중에는 제어 명령만 보수적으로 제한한다.
  -->
  <arg name="workspace_path" default="$(env HOME)/morai_ws" />
  <arg name="path_file" default="$(arg workspace_path)/data/routes/2026_molit_comp_global_path.txt" />
  <arg name="morai_host_ip" default="192.168.0.147" />
  <arg name="control_remote_port" default="9093" />
  <arg name="control_source_port" default="9094" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="gps_port" default="3001" />
  <arg name="imu_port" default="4001" />
  <arg name="ego_status_port" default="9099" />
  <arg name="enable_control" default="false" />
  <arg name="gps_blackout_timeout_sec" default="0.5" />
  <arg name="gps_recovery_valid_samples" default="5" />
  <arg name="blackout_speed_mps" default="1.0" />
  <arg name="recovering_speed_mps" default="1.5" />
  <arg name="stop_on_gps_blackout" default="false" />

  <include file="$(find morai_udp_bridge)/launch/morai_udp_bridge.launch">
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="gps_topic" value="/gps" />
    <arg name="imu_topic" value="/Imu" />
    <arg name="gps_frame_id" value="gps_link" />
    <arg name="imu_frame_id" value="imu_link" />
    <arg name="imu_use_packet_time" value="false" />
  </include>

  <include file="$(find morai_udp_drive_bridge)/launch/morai_udp_drive_bridge.launch">
    <arg name="status_bind_ip" value="$(arg bind_ip)" />
    <arg name="status_port" value="$(arg ego_status_port)" />
    <arg name="status_topic" value="/Ego_topic" />
    <arg name="status_frame_id" value="map" />
    <arg name="control_remote_ip" value="$(arg morai_host_ip)" />
    <arg name="control_remote_port" value="$(arg control_remote_port)" />
    <arg name="control_bind_port" value="$(arg control_source_port)" />
    <arg name="command_topic" value="/ctrl_cmd" />
  </include>

  <node pkg="tf"
        type="static_transform_publisher"
        name="curvature_stability_base_link_to_gps_link"
        args="0 0 1.2 0 0 0 base_link gps_link 100" />
  <node pkg="tf"
        type="static_transform_publisher"
        name="curvature_stability_base_link_to_imu_link"
        args="0 0 0 0 0 0 base_link imu_link 100" />

  <include file="$(find gps_mgeo_converter)/launch/gps_mgeo_converter.launch">
    <arg name="gps_xyz_x" value="0.0" />
    <arg name="gps_xyz_y" value="0.0" />
    <arg name="gps_xyz_z" value="1.2" />
  </include>

  <include file="$(find ekf_local_enu)/launch/ekf_local_enu.launch">
    <arg name="gps_topic" value="/localization/gps" />
    <arg name="imu_topic" value="/Imu" />
    <arg name="default_gps_variance_m2" value="1.0" />
    <arg name="default_yaw_std_deg" value="8.0" />
    <arg name="gyro_noise_std_rad_s" value="0.08" />
    <arg name="accel_noise_std_m_s2" value="0.8" />
    <arg name="bias_random_walk" value="0.001" />
    <arg name="use_sensor_quality_gate" value="false" />
    <arg name="enable_gps_jump_gate" value="false" />
    <arg name="enable_gps_innovation_gate" value="false" />
  </include>

  <node pkg="stability_stack"
        type="gps_blackout_detector.py"
        name="curvature_stability_gps_blackout_detector"
        output="screen">
    <param name="input_topic" value="/gps" />
    <param name="health_topic" value="/localization/gps_health" />
    <param name="status_topic" value="/stability/gps_blackout_status" />
    <param name="blackout_timeout_sec" value="$(arg gps_blackout_timeout_sec)" />
    <param name="recovery_valid_samples" value="$(arg gps_recovery_valid_samples)" />
  </node>

  <node pkg="curvature_speed_purepursuit"
        type="curvature_speed_purepursuit_node.py"
        name="curvature_stability_purepursuit"
        output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="pose_topic" value="/localization/odometry" />
    <param name="command_topic" value="/control/curvature_ctrl_cmd" />
    <param name="publish_command" value="$(arg enable_control)" />
    <param name="pose_timeout_sec" value="0.5" />
    <param name="duplicate_epsilon_m" value="0.000001" />
    <param name="curvature_half_window_points" value="1" />
    <param name="curvature_smoothing_window" value="5" />
    <param name="max_speed_mps" value="2.0" />
    <param name="lateral_accel_limit_mps2" value="1.0" />
    <param name="max_accel_mps2" value="1.0" />
    <param name="max_decel_mps2" value="1.5" />
    <param name="initial_speed_mps" value="0.0" />
    <param name="final_speed_mps" value="0.0" />
    <param name="wheelbase_m" value="3.0" />
    <param name="lookahead_min_m" value="4.0" />
    <param name="lookahead_gain" value="0.35" />
    <param name="goal_tolerance_m" value="1.5" />
    <param name="max_steering_rad" value="0.6981317008" />
    <param name="steering_sign" value="1.0" />
    <param name="longl_cmd_type" value="2" />
    <param name="control_rate_hz" value="20.0" />
    <param name="progress_search_window_points" value="250" />
    <param name="progress_backtrack_tolerance_m" value="2.0" />
  </node>

  <node pkg="stability_stack"
        type="gps_blackout_stability_controller.py"
        name="curvature_stability_blackout_controller"
        output="screen">
    <param name="input_command_topic" value="/control/curvature_ctrl_cmd" />
    <param name="output_command_topic" value="/control/blackout_stable_cmd" />
    <param name="gps_health_topic" value="/localization/gps_health" />
    <param name="enabled" value="true" />
    <param name="blackout_speed_mps" value="$(arg blackout_speed_mps)" />
    <param name="recovering_speed_mps" value="$(arg recovering_speed_mps)" />
    <param name="stop_on_blackout" value="$(arg stop_on_gps_blackout)" />
    <param name="stop_on_health_stale" value="true" />
    <param name="max_steering_rate_rad_s" value="0.5" />
    <param name="max_velocity_rate_mps2" value="1.0" />
  </node>

  <include file="$(find control_mux)/launch/control_mux.launch">
    <arg name="nominal_command_topic" value="/control/blackout_stable_cmd" />
    <arg name="output_command_topic" value="/ctrl_cmd" />
    <arg name="safety_stop_topic" value="/detection/fused_safety_stop" />
    <arg name="require_fresh_safety" value="false" />
    <arg name="require_fresh_localization" value="true" />
    <arg name="lane_correction_enabled" value="false" />
  </include>
</launch>
