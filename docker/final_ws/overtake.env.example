# run_overtake.sh settings. `bash run_overtake.sh init` copies this to overtake.env.
# Competition container that `setup` snapshots (read only; never modified).
BASE_CONTAINER=morai-highway
# Highway zone speeds of the overtaking planner [km/h]. Outside the zone the
# vehicle keeps MAX_SPEED_KPH of highway-test.env, exactly like run_test.sh drive 5.
HIGHWAY_CRUISE_KPH=54.0
HIGHWAY_MAX_KPH=79.2
